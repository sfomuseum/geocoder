BEGIN TRANSACTION;

-- This is deeply unsatisfying. It shouldn't be necessary but it suggests individual WOF records are in multiple repos.
DELETE FROM ancestors WHERE rowid NOT IN (
    SELECT MIN(rowid)
    FROM ancestors
    GROUP BY id, ancestor_id
);

-- See above.
DELETE FROM placetypes_alt WHERE rowid NOT IN (
    SELECT MIN(rowid)
    FROM placetypes_alt
    GROUP BY id, placetype
);

-- Create indices
CREATE UNIQUE INDEX idx_ancestors ON ancestors (id, ancestor_id);
CREATE UNIQUE INDEX idx_placetypes_alt ON placetypes_alt (id, placetype);
CREATE INDEX bounds_by_wofid ON bounds (wofid);

CREATE INDEX idx_dates_outer ON dates (start_outer, end_outer);
CREATE INDEX idx_dates_outer_inner ON dates (start_outer, end_inner);
CREATE INDEX idx_dates_inner_outer ON dates (start_inner, end_outer);
CREATE INDEX idx_dates_inner ON dates (start_inner, end_inner);

CREATE INDEX idx_tokens_covering ON tokens (row_id, id, lang, tag);
CREATE INDEX idx_bounds_covering ON bounds (wofid, minx, maxx, miny, maxy);
CREATE INDEX idx_records_sorting ON records(id, is_current, population_rank, placetype, country);

-- Set up FTS
CREATE VIRTUAL TABLE tokens_fts USING fts5 (
    token,
    lang,
    content='tokens',
    content_rowid='row_id',
    tokenize="unicode61 remove_diacritics 0 tokenchars '_'",
    prefix='3 5 8', -- Optimized: Reduced down to 3 selective lengths instead of 12
    columnsize=0
);

-- Populate FTS
INSERT INTO tokens_fts(rowid, token, lang) 
SELECT row_id, token, lang FROM tokens;

-- FTS triggers
CREATE TRIGGER tokens_insert AFTER INSERT ON tokens BEGIN
  INSERT INTO tokens_fts(rowid, token, lang) VALUES (new.row_id, new.token, new.lang);
END;

CREATE TRIGGER tokens_delete AFTER DELETE ON tokens BEGIN
  INSERT INTO tokens_fts(tokens_fts, rowid, token, lang) VALUES('delete', old.row_id, old.token, old.lang);
END;

COMMIT;

PRAGMA optimize;
INSERT INTO tokens_fts(tokens_fts) VALUES('optimize');
